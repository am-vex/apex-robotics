{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\nratchet_motor_a = Motor(Ports.PORT3, True)\nratchet_motor_b = Motor(Ports.PORT10, False)\nratchet = MotorGroup(ratchet_motor_a, ratchet_motor_b)\nclawLift_motor_a = Motor(Ports.PORT6, True)\nclawLift_motor_b = Motor(Ports.PORT12, False)\nclawLift = MotorGroup(clawLift_motor_a, clawLift_motor_b)\nleft_drive_smart = Motor(Ports.PORT5, 1.0, False)\nright_drive_smart = Motor(Ports.PORT11, 1.0, True)\n\ndrivetrain = SmartDrive(left_drive_smart, right_drive_smart, brain_inertial, 200)\nLeftSolenoid = Pneumatic(Ports.PORT9)\nRightSolenoid = Pneumatic(Ports.PORT4)\ncontroller = Controller()\ntouchLED = Touchled(Ports.PORT2)\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\nvexcode_initial_drivetrain_calibration_completed = False\ndef calibrate_drivetrain():\n    # Calibrate the Drivetrain Inertial\n    global vexcode_initial_drivetrain_calibration_completed\n    if not vexcode_initial_drivetrain_calibration_completed:\n        LeftSolenoid.pump_off()\n        RightSolenoid.pump_off()\n    sleep(200, MSEC)\n    brain.screen.print(\"Calibrating\")\n    brain.screen.next_row()\n    brain.screen.print(\"Inertial\")\n    brain_inertial.calibrate()\n    while brain_inertial.is_calibrating():\n        sleep(25, MSEC)\n    if not vexcode_initial_drivetrain_calibration_completed:\n        LeftSolenoid.pump_on()\n        RightSolenoid.pump_on()\n    vexcode_initial_drivetrain_calibration_completed = True\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n\n\n# Calibrate the Drivetrain\ncalibrate_drivetrain()\n\n#endregion VEXcode Generated Robot Configuration\nRightSolenoid.pump_on()\nLeftSolenoid.pump_on()\nclawOpened = False\nRightSolenoid.retract(CYLINDER2)\nLeftSolenoid.retract(CYLINDER1)\nRightSolenoid.retract(CYLINDER1)\nLeftSolenoid.retract(CYLINDER2)\nclawLift.set_position(0, DEGREES)\nclawLift.spin_for(FORWARD, 20, DEGREES)\nratchet.set_velocity(100, PERCENT)\ndef stopProgram():\n    if controller.buttonEDown.pressing():\n        brain.program_stop()\ndef useClaw(usage):\n    if usage == \"open\":\n        LeftSolenoid.retract(CYLINDER1)\n        RightSolenoid.retract(CYLINDER2)\n    elif usage == \"close\":\n        LeftSolenoid.extend(CYLINDER1)\n        RightSolenoid.extend(CYLINDER2)\ndef usePCH(usage):\n    if usage == \"retract\":\n        LeftSolenoid.retract(CYLINDER2)\n        RightSolenoid.retract(CYLINDER1)\n    elif usage == \"extend\":\n        LeftSolenoid.extend(CYLINDER2)\n        RightSolenoid.extend(CYLINDER1)\n\n\nPCHed = True\nclawOpen = True\nfloored = False\nleftStop = False\nrightStop = False\nprevL3 = controller.buttonL3.pressing()\nclawStep = 0\nlastRup = False\nremote_control_code_enabled = True\ndef floorF():\n    while True:\n        if controller.buttonR3.pressing():\n            clawLift.spin_to_position(4, DEGREES)\ndef drivetrainF():\n    global leftStop, rightStop\n    while True:\n        forward = controller.axisA.position()\n        turn = controller.axisC.position() * 0.9\n\n        leftSpeed = forward - turn\n        rightSpeed = forward + turn\n\n        if abs(leftSpeed) < 2.5:\n            left_drive_smart.stop()\n            leftStop = False\n        else:\n            leftStop = True\n\n        if abs(rightSpeed) < 2.5:\n            right_drive_smart.stop()\n            rightStop = False\n        else:\n            rightStop = True\n\n        if leftStop:\n            left_drive_smart.set_velocity(leftSpeed, PERCENT)\n            left_drive_smart.spin(FORWARD)\n\n        if rightStop:\n            right_drive_smart.set_velocity(rightSpeed, PERCENT)\n            right_drive_smart.spin(FORWARD)\n\n        wait(10, MSEC)\n\ndef ratchetControl():\n    while True:\n        if controller.buttonLDown.pressing():\n            ratchet.spin_for(REVERSE, 60, DEGREES)\n            wait(100, MSEC)\n            ratchet.spin_for(REVERSE, 2030, DEGREES, wait=False)\n            wait(100, MSEC)\n        if controller.buttonRDown.pressing():\n            ratchet.spin_for(FORWARD, 50, DEGREES)\n            wait(100, MSEC)\n            ratchet.spin_for(REVERSE, 60, DEGREES)\n            wait(100, MSEC)\n            clawLift.spin_to_position(4, DEGREES)\n            ratchet.spin_for(REVERSE, 2030, DEGREES, wait=False)\n            wait(100, MSEC)\n\n        wait(10, MSEC)\ndef touch():\n    while True:\n        touchLED.set_color(Color.RED)\n        wait(100, MSEC)\n        touchLED.set_color(Color.RED_ORANGE)\n        wait(100, MSEC)\n        touchLED.set_color(Color.ORANGE)\n        wait(100, MSEC)\n        touchLED.set_color(Color.YELLOW_ORANGE)\n        wait(100, MSEC)\n        touchLED.set_color(Color.YELLOW)\n        wait(100, MSEC)\n        touchLED.set_color(Color.YELLOW_GREEN)\n        wait(100, MSEC)\n        touchLED.set_color(Color.GREEN)\n        wait(100, MSEC)\n        touchLED.set_color(Color.BLUE_GREEN)\n        wait(100, MSEC)\n        touchLED.set_color(Color.BLUE)\n        wait(100, MSEC)\n        touchLED.set_color(Color.BLUE_VIOLET)\n        wait(100, MSEC)\n        touchLED.set_color(Color.VIOLET)\n        wait(100, MSEC)\n        touchLED.set_color(Color.RED_VIOLET)\n        wait(100, MSEC)\ndef loadCatapult():\n    while True:\n        if controller.buttonLUp.pressing():\n            useClaw(\"close\")\n            clawOpened = False\n            wait(200, MSEC)\n\n            clawLift.spin_for(FORWARD, 133, DEGREES)\n            wait(100, MSEC)\n\n            usePCH(\"extend\")\n            wait(500, MSEC)\n\n            clawLift.spin_for(REVERSE, 75, DEGREES)\n            wait(100, MSEC)\n            useClaw(\"open\")\n            clawOpened = True\n            wait(500, MSEC)\n            clawLift.spin_for(FORWARD, 33, DEGREES)\n            wait(250, MSEC)\n            usePCH(\"retract\")\n            wait(200, MSEC)\n            clawLift.spin_to_position(64, DEGREES)\n            wait(200, MSEC)\n            \n\ndef l4():\n    global clawStep, lastRup, remote_control_code_enabled\n    while True:\n        rup = controller.buttonRUp.pressing()\n\n        if rup and not lastRup:\n\n            if clawStep == 0:\n                useClaw(\"close\")\n                clawOpened = False\n                clawStep = 1\n\n            elif clawStep == 1:\n                clawLift.set_velocity(300, PERCENT)\n                clawLift.spin_for(FORWARD, 375, DEGREES)\n                clawStep = 2\n\n            elif clawStep == 2:\n                useClaw(\"open\")\n                clawOpened = True\n                clawStep = 3\n\n            elif clawStep == 3:\n                clawLift.set_velocity(50, PERCENT)\n                clawLift.spin_for(REVERSE, 375, DEGREES)\n                clawStep = 0\n\n        lastRup = rup\n        wait(10, MSEC)\n\ndef clamp():\n    global clawOpened, prevL3\n    while True:\n        if controller.buttonL3.pressing() and not prevL3:\n            drivetrain.stop()\n            if clawOpened:\n                useClaw(\"close\")\n                clawOpened = False\n            else:\n                useClaw(\"open\")\n                clawOpened = True\n\n        prevL3 = controller.buttonL3.pressing()\n        wait(10, MSEC)\ndef check():\n    while True:\n        print()\ndrivetrainT = Thread(drivetrainF)\nratchetT = Thread(ratchetControl)\nloadCatapultT = Thread(loadCatapult)\nl4T = Thread(l4)\nclampT = Thread(clamp)\nfloorT = Thread(floorF)\ntouchT = Thread(touch)","textLanguage":"python","robotConfig":[{"port":[3,10],"name":"ratchet","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[6,12],"name":"clawLift","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[5,11,0],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"2-motor","wheelSize":"200mm","gearRatio":"1:1","direction":"fwd","gyroType":"integrated","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[9],"name":"LeftSolenoid","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"cylinder1","cylinder2":"cylinder2","cylinder1_reversed":"false","cylinder2_reversed":"false","cylinder3":"","cylinder4":""},"triportSourcePort":22},{"port":[4],"name":"RightSolenoid","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"cylinder1","cylinder2":"cylinder2","cylinder1_reversed":"false","cylinder2_reversed":"false","cylinder3":"","cylinder4":""},"triportSourcePort":22},{"port":[],"name":"controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"},"triportSourcePort":22},{"port":[2],"name":"touchLED","customName":true,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}